@echo off
chcp 65001 > nul
title أداة إعادة ضبط المصنع لتسليم العميل - سريع وبنشر PRO

echo ======================================================================
echo           أداة إعادة ضبط المصنع الشاملة (تجهيز النظام للتسليم)
echo                         سريع وبنشر PRO
echo ======================================================================
echo.
echo تحذير أمني هام:
echo هذه الأداة ستقوم بتجهيز النظام بحزمة التسليم الاحترافية المتكاملة:
echo   1. تصفير ومسح كافة فواتير المبيعات، المشتريات، المردودات، والورديات.
echo   2. مسح كافة الأصناف والموردين والعملاء (مع إبقاء العميل النقدي السريع).
echo   3. تصفير وتهيئة بيانات طاقم العمل (0 موظف لإدخالهم من الصفر).
echo   4. إعادة تفعيل معالج الإعداد الترحيبي (Wizard) ليظهر للعميل عند أول تشغيل.
echo   5. تصفير عداد الترخيص وبدء فترة تجريبية جديدة (14 يوماً مجانية).
echo   6. تنظيف وتطهير كافة سجلات التشغيل القديمة (Logs).
echo.
echo (سيتم أخذ نسخة أمان احتياطية تلقائياً قبل أي مسح في مجلد backups)
echo.
echo ======================================================================
set /p confirm=لتأكيد ضبط المصنع الشامل، اكتب كلمة RESET ثم اضغط Enter: 

if /i not "%confirm%"=="RESET" (
    echo.
    echo [إلغاء]: تم إلغاء العملية ولم يتم المساس بأي بيانات.
    echo.
    pause
    exit /b
)

echo.
echo جاري تنفيذ إعادة ضبط المصنع والتصفير الشامل...
echo.

node server/scripts/factory_reset_blank_slate.js

echo.
echo ======================================================================
echo اكتملت العملية بنجاح! النظام الآن في الوضع الافتراضي النظيف 100%.
echo جاهز للتسليم للعميل. اضغط أي مفتاح للخروج...
pause > nul
