@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ====================================================================
echo   جاري تفعيل إقلاع نظام سريع وبنشر PRO تلقائياً مع تشغيل الويندوز...
echo ====================================================================

node server/scripts/manageShortcuts.js startup

if %ERRORLEVEL% EQU 0 (
    echo.
    echo [OK] تم تفعيل التشغيل التلقائي بنجاح!
    echo      سيبدأ النظام بالعمل فوراً وبشكل تلقائي بمجرد تشغيل جهاز الكشك.
) else (
    echo.
    echo [ERROR] حدث خطأ أثناء إعداد التشغيل التلقائي.
)
echo.
pause
